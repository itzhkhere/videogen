++/// Where JS time starts: the instant `performance.now()` is 0 and the epoch time of that
++/// instant (`performance.timeOrigin`, `Date.now()` at 0). Shared with the Boa clock adapter.
++pub(crate) struct ClockOrigin {
++    pub base: Cell<Instant>,
++    pub epoch_ms: Cell<f64>,
++}
++
+ impl Default for ScriptClock {
+     fn default() -> Self {
++        let wall = SystemTime::now()
++            .duration_since(UNIX_EPOCH)
++            .unwrap_or(Duration::ZERO)
++            .as_millis() as f64;
+         Self {
+             inner: Rc::new(RefCell::new(ClockMode::Real)),
++            origin: Rc::new(ClockOrigin {
++                base: Cell::new(Instant::now()),
++                epoch_ms: Cell::new(wall),
++            }),
+         }
+     }
+ }
+@@ -40,13 +57,14 @@ impl ScriptClock {
+     }
+ 
+     /// Switch to virtual mode. Time stops at the current instant and only
+-    /// advances via [`advance_to`](Self::advance_to).
++    /// advances via [`advance_to`](Self::advance_to). The time origin moves to that instant,
++    /// so that `performance.now()` is exactly the virtual time elapsed.
+     pub fn make_virtual(&self) {
+         let mut mode = self.inner.borrow_mut();
+         if matches!(*mode, ClockMode::Real) {
+-            *mode = ClockMode::Virtual {
+-                now: Instant::now(),
+-            };
++            let now = Instant::now();
++            *mode = ClockMode::Virtual { now };
++            self.origin.base.set(now);

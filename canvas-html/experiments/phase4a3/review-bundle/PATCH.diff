+    assert_eq!(d.event_path(el).unwrap(), vec![el]);
+    d.append_child(body, el).unwrap();
+    let path = d.event_path(el).unwrap();
+    assert_eq!(path.first(), Some(&el));
+    assert_eq!(path.last(), Some(&d.document_node()));

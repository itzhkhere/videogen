++    /// The shared clock contract (see dom-host): `Date.now() = floor(epoch + t)`,
++    /// `performance.now() = t`, `performance.timeOrigin = epoch`.
++    pub fn contract(&self) -> ClockContract {
++        ClockContract::new(self.origin.epoch_ms.get())
++    }

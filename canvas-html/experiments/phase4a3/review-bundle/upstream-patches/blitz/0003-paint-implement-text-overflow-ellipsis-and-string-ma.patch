+
+/// `text-overflow: ellipsis | <string>` on an inline root whose `overflow` clips.
+#[derive(Clone)]
+struct TextOverflowEllipsis {
+    /// Right edge of the content box, in the layout's (device pixel) coordinates.
+    clip_right: f32,
+    /// The marker: "…" for `ellipsis`, or the author's string.
+    marker: String,
+    /// Right edge of the glyphs kept so far on the current line.
+    last_end_x: f32,
+    /// The marker has been drawn on the current line; skip the rest of it.
+    done: bool,
+}
+
+impl TextOverflowEllipsis {
+    fn for_inline_root(doc: &BaseDocument, node_id: NodeId, scale: f64) -> Option<Self> {
+        use style::values::computed::Overflow;
+        use style::values::specified::text::TextOverflowSide;
+        let node = doc.get_node(node_id)?;
+        let styles = node.primary_styles()?;
+        if styles.clone_overflow_x() == Overflow::Visible {
+            return None;
+        }
+        // One value applies to the end of the line; with two, the second is the right side.
+        let marker = match styles.clone_text_overflow().second {
+            TextOverflowSide::Clip => return None,
+            TextOverflowSide::Ellipsis => "\u{2026}".to_string(),
+            TextOverflowSide::String(s) => s.to_string(),
+        };
+        let l = node.final_layout();
+        let content_width = l.size.width
+            - l.padding.left
+            - l.padding.right
+            - l.border.left
+            - l.border.right
+            - l.scrollbar_size.width;
+        Some(Self {
+            clip_right: (content_width as f64 * scale) as f32,
+            marker,
+            last_end_x: 0.0,
+            done: false,
+        })
+    }
+
+    /// Whether `line` extends past the clip edge (and so needs a marker).
+    fn line_overflows(&self, line: &Line<'_, TextBrush>) -> bool {
+        let mut right = 0.0f32;
+        for item in line.items() {
+            if let PositionedLayoutItem::GlyphRun(run) = item {
+                right = right.max(run.offset() + run.advance());
+            }
+        }
+        right > self.clip_right + 0.01
+    }
+
+    /// Glyph ids and advances of the marker in the given font (simple cmap lookup; the marker
+    /// is short and typically a single "…"). Characters the font lacks are skipped, and a font
+    /// without U+2026 falls back to "...".
+    fn shape_marker(
+        &self,
+        font: &parley::FontData,
+        font_size: f32,
+        coords: &[i16],
+    ) -> (Vec<(u32, f32)>, f32) {
+        use skrifa::{FontRef, MetadataProvider as _, instance::LocationRef, instance::Size};
+        let Ok(font_ref) = FontRef::from_index(font.data.as_ref(), font.index) else {
+            return (Vec::new(), 0.0);
+        };
+        let charmap = font_ref.charmap();
+        let coords: Vec<skrifa::instance::NormalizedCoord> = coords
+            .iter()
+            .map(|c| skrifa::instance::NormalizedCoord::from_bits(*c))
+            .collect();
+        let metrics = font_ref.glyph_metrics(Size::new(font_size), LocationRef::new(&coords));
+        let shape = |text: &str| -> Option<(Vec<(u32, f32)>, f32)> {
+            let mut out = Vec::new();
+            let mut width = 0.0;
+            for c in text.chars() {
+                let gid = charmap.map(c)?;
+                let adv = metrics.advance_width(gid).unwrap_or(0.0);
+                out.push((gid.to_u32(), adv));
+                width += adv;
+            }
+            Some((out, width))
+        };
+        shape(&self.marker)
+            .or_else(|| (self.marker == "\u{2026}").then(|| shape("...")).flatten())
+            .unwrap_or((Vec::new(), 0.0))
+    }
+}

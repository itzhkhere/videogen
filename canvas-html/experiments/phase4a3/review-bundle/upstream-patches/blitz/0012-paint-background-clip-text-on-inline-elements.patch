+    /// `background-clip: text` on inline elements inside this element's inline layout (such as
+    /// a gradient word in a heading). For each such element, paint its background over the box
+    /// that covers its glyph runs (the union of the runs' ascent-to-descent boxes), then keep
+    /// the background only under those glyphs. `inline_transform` places the layout's origin.
+    ///
+    /// Simplification: an element that wraps onto several lines gets one box over all its
+    /// fragments, so the background is not sliced per line as with
+    /// `box-decoration-break: slice`.
+    pub(super) fn draw_inline_clip_text_backgrounds(
+        &self,
+        scene: &mut impl PaintScene,
+        layout: &parley::Layout<blitz_dom::node::TextBrush>,
+        inline_transform: Affine,
+    ) {
+        use parley::PositionedLayoutItem;
+
+        let dom = self.context.dom;
+        let root_id = self.node.id;
+        // The nearest inline ancestor (or the run's own node) that clips its background to text.
+        let clip_owner = |mut id: NodeId| -> Option<NodeId> {
+            while id != root_id {
+                let node = dom.get_node(id)?;
+                if let Some(styles) = node.primary_styles() {
+                    if styles
+                        .get_background()
+                        .background_clip
+                        .0
+                        .iter()
+                        .any(|c| matches!(c, StyloBackgroundClip::Text))
+                    {
+                        return Some(id);
+                    }
+                }
+                id = node.parent?;
+            }
+            None
+        };
+
+        let mut groups: Vec<(NodeId, Rect)> = Vec::new();
+        for line in layout.lines() {
+            for item in line.items() {
+                let PositionedLayoutItem::GlyphRun(glyph_run) = item else {
+                    continue;
+                };
+                let Some(owner) = clip_owner(glyph_run.style().brush.id) else {
+                    continue;
+                };
+                let metrics = glyph_run.run().font_metrics();
+                let x = glyph_run.offset() as f64;
+                let baseline = glyph_run.baseline() as f64;
+                let rect = Rect::new(
+                    x,
+                    baseline - metrics.ascent as f64,
+                    x + glyph_run.advance() as f64,
+                    baseline + metrics.descent as f64,
+                );
+                match groups.iter_mut().find(|(id, _)| *id == owner) {
+                    Some((_, r)) => *r = r.union(rect),
+                    None => groups.push((owner, rect)),
+                }
+            }
+        }
+
+        for (owner, rect) in groups {
+            let Some(node) = dom.get_node(owner) else {
+                continue;
+            };
+            let (Some(style), Some(element)) = (node.primary_styles(), node.element_data()) else {
+                continue;
+            };
+            let frame = crate::kurbo_css::CssBox::new(
+                Rect::from_origin_size(Point::ZERO, rect.size()),
+                kurbo::Insets::ZERO,
+                kurbo::Insets::ZERO,
+                0.0,
+                crate::kurbo_css::NonUniformRoundedRectRadii::default(),
+            );
+            let cx = ElementCx {
+                context: self.context,
+                frame,
+                style: (*style).clone(),
+                scale: self.scale,
+                node,
+                element,
+                transform: inline_transform * Affine::translate(rect.origin().to_vec2()),
+                #[cfg(feature = "svg")]
+                svg: None,
+                text_input: None,
+                list_item: None,
+                devtools: self.devtools,
+                custom_widget_scene: None,
+            };
+            scene.push_layer(
+                Fill::NonZero,
+                Mix::Normal,
+                1.0,
+                inline_transform,
+                &rect,
+                None,
+                None,
+            );
+            cx.draw_background_layers(scene);
+            scene.push_layer(
+                Fill::NonZero,
+                Compose::DestIn,
+                1.0,
+                inline_transform,
+                &rect,
+                None,
+                None,
+            );
+            crate::text::draw_glyph_mask_where(scene, layout.lines(), inline_transform, |brush| {
+                clip_owner(brush.id) == Some(owner)
+            });
+            scene.pop_layer();
+            scene.pop_layer();
+        }
+    }
+

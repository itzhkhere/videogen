From c59b2d6749f3dd3f60ff2344410695ab75d28a65 Mon Sep 17 00:00:00 2001
From: local <l@l>
Date: Mon, 5 Oct 2026 16:08:10 +0000
Subject: [PATCH 7/9] dom: keep the animation timeline time for restyles
 triggered from script (layout queries no longer reset animations to t=0)

---
 packages/blitz-dom/src/document.rs            |  4 +++
 packages/blitz-dom/src/resolve.rs             | 13 ++++++++
 packages/blitz-dom/src/stylo.rs               |  2 +-
 .../blitz-vibey-script/src/dom/document.rs    |  4 +--
 .../blitz-vibey-script/src/dom/element.rs     | 30 +++++++++----------
 packages/blitz-vibey-script/src/dom/style.rs  |  2 +-
 packages/blitz-vibey-script/src/runtime.rs    |  4 +--
 7 files changed, 38 insertions(+), 21 deletions(-)

diff --git a/packages/blitz-dom/src/document.rs b/packages/blitz-dom/src/document.rs
index 41154db..82a6f24 100644
--- a/packages/blitz-dom/src/document.rs
+++ b/packages/blitz-dom/src/document.rs
@@ -289,6 +289,9 @@ pub struct BaseDocument {
     // TODO: collapse animating state into a bitflags
     /// Whether there are active CSS animations/transitions (so we should re-render every frame)
     pub(crate) has_active_animations: bool,
+    /// The time (in seconds) passed to the most recent `resolve`: the document's animation
+    /// timeline. Restyles triggered from script (layout queries) reuse it.
+    pub(crate) animation_time: f64,
     /// Whether there is a `<canvas>` element in the DOM (so we should re-render every frame)
     pub(crate) has_canvas: bool,
     /// Whether there are subdocuments that are animating (so we should re-render every frame)
@@ -469,6 +472,7 @@ impl BaseDocument {
             active_node_id: None,
             mousedown_node_id: None,
             has_active_animations: false,
+            animation_time: 0.0,
             subdoc_is_animating: false,
             has_canvas: false,
             sub_document_nodes: HashSet::new(),
diff --git a/packages/blitz-dom/src/resolve.rs b/packages/blitz-dom/src/resolve.rs
index 7eac5d7..6150393 100644
--- a/packages/blitz-dom/src/resolve.rs
+++ b/packages/blitz-dom/src/resolve.rs
@@ -35,7 +35,20 @@ use crate::{
 
 impl BaseDocument {
     /// Restyle the tree and then relayout it
+    /// The time (in seconds) of the document's animation timeline, as given to the most recent
+    /// [`resolve`](Self::resolve). Use it to restyle without moving animations, for example for
+    /// layout queries made from script.
+    pub fn animation_time(&self) -> f64 {
+        self.animation_time
+    }
+
+    /// Restyle and relayout at the current animation time (see [`animation_time`](Self::animation_time)).
+    pub fn resolve_at_current_time(&mut self) {
+        self.resolve(self.animation_time);
+    }
+
     pub fn resolve(&mut self, current_time_for_animations: f64) {
+        self.animation_time = current_time_for_animations;
         if TDocument::as_node(&self.root_node())
             .first_element_child()
             .is_none()
diff --git a/packages/blitz-dom/src/stylo.rs b/packages/blitz-dom/src/stylo.rs
index 96998d7..7611eee 100644
--- a/packages/blitz-dom/src/stylo.rs
+++ b/packages/blitz-dom/src/stylo.rs
@@ -212,7 +212,7 @@ impl crate::document::BaseDocument {
             guards,
             visited_styles_enabled: false,
             animations: self.animations.clone(),
-            current_time_for_animations: 0.0,
+            current_time_for_animations: self.animation_time,
             snapshot_map: &self.snapshots,
             registered_speculative_painters: &RegisteredPaintersImpl,
         };

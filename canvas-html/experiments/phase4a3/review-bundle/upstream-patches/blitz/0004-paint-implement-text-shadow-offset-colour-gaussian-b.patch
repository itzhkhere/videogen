+/// Paint the `text-shadow`s of every glyph run on `line`: each shadow is the run's glyphs in
+/// the shadow colour, offset, and (for a non-zero blur radius) blurred with a gaussian of
+/// standard deviation radius / 2, as the spec defines. Shadows are painted back to front, so
+/// the first one listed ends up on top.
+fn draw_line_text_shadows(
+    scene: &mut impl PaintScene,
+    line: &Line<'_, TextBrush>,
+    doc: &BaseDocument,
+    transform: Affine,
+    scale: f64,
+    mut overflow_cut: Option<TextOverflowEllipsis>,
+) {
+    use anyrender::filters::{Filter, FilterEffect};
+    use std::sync::Arc;
+
+    for item in line.items() {
+        let PositionedLayoutItem::GlyphRun(glyph_run) = item else {
+            continue;
+        };
+        if overflow_cut.as_ref().is_some_and(|c| c.done) {
+            break;
+        }
+        let Some(styles) = doc
+            .get_node(glyph_run.style().brush.id)
+            .and_then(|node| node.primary_styles())
+        else {
+            continue;
+        };
+        let shadows = &styles.get_inherited_text().text_shadow.0;
+        let run = glyph_run.run();
+        let font = &run.font().font;
+        let font_size = run.font_size();
+        let normalized_coords: &[i16] = bytemuck::cast_slice(run.normalized_coords());
+        // Keep the truncation state in step with the text pass even for runs without shadows.
+        let (glyphs, marker) = visible_glyphs(
+            &glyph_run,
+            overflow_cut.as_mut(),
+            font,
+            font_size,
+            normalized_coords,
+        );
+        if shadows.is_empty() {
+            continue;
+        }
+        let glyphs: Vec<anyrender::Glyph> = glyphs.into_iter().chain(marker.unwrap_or_default()).collect();
+        let synthesis = run.synthesis();
+        let glyph_xform = synthesis
+            .skew()
+            .map(|angle| Affine::skew(angle.to_radians().tan() as f64, 0.0));
+        let embolden = if synthesis.embolden() {
+            kurbo::Vec2::splat(font_size as f64 / 28.0)
+        } else {
+            kurbo::Vec2::default()
+        };
+        let current_color = styles.clone_color();
+        let metrics = run.font_metrics();
+        let baseline = glyph_run.baseline() as f64;
+        let run_bounds = Rect::new(
+            glyph_run.offset() as f64,
+            baseline - metrics.ascent as f64,
+            (glyph_run.offset() + glyph_run.advance()) as f64,
+            baseline + metrics.descent as f64,
+        );
+
+        for shadow in shadows.iter().rev() {
+            let color = shadow.color.resolve_to_absolute(&current_color).as_srgb_color();
+            let dx = shadow.horizontal.px() as f64 * scale;
+            let dy = shadow.vertical.px() as f64 * scale;
+            let blur = shadow.blur.px() as f64 * scale;
+            let shadow_transform = transform * Affine::translate((dx, dy));
+            let blurred = blur > 0.0;
+            if blurred {
+                // Gaussian blur reaches ~3 standard deviations; pad the layer bounds by that.
+                let std_dev = blur / 2.0;
+                let bounds = run_bounds.inflate(3.0 * std_dev + 1.0, 3.0 * std_dev + 1.0);
+                scene.push_layer(
+                    Fill::NonZero,
+                    peniko::Mix::Normal,
+                    1.0,
+                    shadow_transform,
+                    &bounds,
+                    Some(Arc::new(Filter::linear_list(std::iter::once(FilterEffect::blur(std_dev as f32))))),
+                    None,
+                );
+            }
+            scene.draw_glyphs(
+                font,
+                font_size,
+                !FONT_EMBOLDEN_ENABLED, // hint
+                normalized_coords,
+                embolden,
+                Fill::NonZero,
+                &anyrender::Paint::from(color),
+                1.0, // alpha
+                shadow_transform,
+                glyph_xform,
+                glyphs.iter().copied(),
+            );
+            if blurred {
+                scene.pop_layer();
+            }
+        }
+    }
+}
+
+/// The glyphs of `glyph_run` that are painted, plus the text-overflow marker glyphs when the
+/// run crosses the cut (see [`TextOverflowEllipsis`]). Shared by the text and its shadows so
+/// both are truncated identically.
+fn visible_glyphs(
+    glyph_run: &parley::layout::GlyphRun<'_, TextBrush>,
+    overflow_cut: Option<&mut TextOverflowEllipsis>,
+    font: &parley::FontData,
+    font_size: f32,
+    normalized_coords: &[i16],
+) -> (Vec<anyrender::Glyph>, Option<Vec<anyrender::Glyph>>) {
+    let to_glyph = |glyph: parley::layout::Glyph| anyrender::Glyph {
+        id: glyph.id as _,
+        x: glyph.x,
+        y: glyph.y,
+    };
+    let Some(cut) = overflow_cut.filter(|_| !glyph_run.run().is_rtl()) else {
+        return (glyph_run.positioned_glyphs().map(to_glyph).collect(), None);
+    };
+    let (marker_glyphs, marker_width) = cut.shape_marker(font, font_size, normalized_coords);
+    let limit = cut.clip_right - marker_width;
+    let mut glyphs = Vec::new();
+    let mut end_x = glyph_run.offset();
+    for glyph in glyph_run.positioned_glyphs() {
+        if glyph.x + glyph.advance > limit + 0.01 {
+            cut.done = true;
+            break;
+        }
+        end_x = glyph.x + glyph.advance;
+        glyphs.push(to_glyph(glyph));
+    }
+    if !cut.done {
+        return (glyphs, None);
+    }
+    let baseline = glyph_run.baseline();
+    let mut x = end_x;
+    let marker = marker_glyphs
+        .into_iter()
+        .map(|(id, adv)| {
+            let g = anyrender::Glyph { id, x, y: baseline };
+            x += adv;
+            g
+        })
+        .collect();
+    (glyphs, Some(marker))
+}

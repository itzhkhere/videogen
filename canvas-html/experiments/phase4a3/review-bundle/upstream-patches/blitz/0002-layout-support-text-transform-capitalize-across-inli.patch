+
+/// `text-transform: capitalize`: uppercase the first letter or digit of each word. A word
+/// starts after whitespace (or at the start of the inline formatting context); punctuation
+/// before the first letter, as in "(hello", does not end the word start.
+fn capitalize_words(text: &str, at_word_start: &mut bool) -> String {
+    let mut out = String::with_capacity(text.len());
+    for c in text.chars() {
+        if c.is_whitespace() {
+            *at_word_start = true;
+            out.push(c);
+        } else if c.is_alphanumeric() {
+            if *at_word_start {
+                out.extend(c.to_uppercase());
+                *at_word_start = false;
+            } else {
+                out.push(c);
+            }
+        } else {
+            out.push(c);
+        }
+    }
+    out
+}
+
+/// Track word starts through text that is not capitalized itself.
+fn update_word_start(text: &str, at_word_start: &mut bool) {
+    for c in text.chars() {
+        if c.is_whitespace() {
+            *at_word_start = true;
+        } else if c.is_alphanumeric() {
+            *at_word_start = false;
+        }
+    }
+}
+
+#[cfg(test)]
+mod capitalize_tests {
+    use super::capitalize_words;
+
+    #[test]
+    fn capitalizes_each_word_across_text_nodes() {
+        let mut start = true;
+        assert_eq!(capitalize_words("hello wide", &mut start), "Hello Wide");
+        // "wide" + "r world": the second node continues the word "wider"
+        assert_eq!(capitalize_words("r world", &mut start), "r World");
+        assert_eq!(capitalize_words(" (quoted) well-known", &mut start), " (Quoted) Well-known");
+    }
+}

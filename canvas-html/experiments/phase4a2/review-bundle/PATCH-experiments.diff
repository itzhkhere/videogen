+mv evidence/output-regression-*-$TAG.json evidence/sanity-bench-$TAG.json evidence/$TAG/ 2>/dev/null
+tar -czf /content/results-4a2-$TAG.tgz evidence/$TAG && ls -l /content/results-4a2-$TAG.tgz
+echo ALL_DONE

+/// `__blitz_class_list(element, op, ...args)`: DOMTokenList operations for the bootstrap's
+/// cached `classList` object, implemented by the shared host.
+pub(crate) fn class_list_op(
+    _: &JsValue,
+    args: &[JsValue],
+    context: &mut Context,
+) -> JsResult<JsValue> {
+    let handle = args
+        .first()
+        .and_then(super::node_id_of_value)
+        .map(canvas_dom_host::NodeHandle::from)
+        .ok_or_else(|| {
+            boa_engine::JsError::from(
+                boa_engine::JsNativeError::typ().with_message("classList: not an element"),
+            )
+        })?;
+    let op = to_rust_string(args.get(1).unwrap_or(&JsValue::undefined()), context)?;
+    let mut rest = Vec::new();
+    for value in args.iter().skip(2) {
+        if !value.is_undefined() {
+            rest.push(to_rust_string(value, context)?);
+        }
+    }
+    let tokens: Vec<&str> = rest.iter().map(String::as_str).collect();
+    match op.as_str() {
+        "list" => {
+            let list = super::host(context, |doc| doc.class_list(handle))?;
+            let values: Vec<JsValue> = list.iter().map(|t| js_str(t)).collect();
+            Ok(boa_engine::object::builtins::JsArray::from_iter(values, context).into())
+        }
+        "add" => {
+            super::host(context, |doc| doc.class_list_add(handle, &tokens))?;
+            Ok(JsValue::undefined())
+        }
+        "remove" => {
+            super::host(context, |doc| doc.class_list_remove(handle, &tokens))?;
+            Ok(JsValue::undefined())
+        }
+        "contains" => {
+            let token = tokens.first().copied().unwrap_or("");
+            Ok(JsValue::from(super::host(context, |doc| doc.class_list_contains(handle, token))?))
+        }
+        "toggle" => {
+            let token = tokens.first().copied().unwrap_or("undefined");
+            let force = args.get(3).filter(|v| !v.is_undefined()).map(|v| v.to_boolean());
+            Ok(JsValue::from(super::host(context, |doc| {
+                doc.class_list_toggle(handle, token, force)
+            })?))
+        }
+        _ => Err(boa_engine::JsNativeError::typ()
+            .with_message(format!("classList: unknown operation {op}"))
+            .into()),
+    }
 }
 

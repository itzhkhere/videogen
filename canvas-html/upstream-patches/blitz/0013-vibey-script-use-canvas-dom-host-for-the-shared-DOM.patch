+
+/// Throw a shared host error as the JS exception canvas-dom-host prescribes, so that Boa and
+/// the Deno adapter fail identically.
+pub(crate) fn throw_dom(context: &mut Context, error: canvas_dom_host::DomError) -> boa_engine::JsError {
+    match error.js_error() {
+        canvas_dom_host::JsErrorKind::DomException(name) => {
+            dom_exception(context, name, &error.to_string())
+        }
+        canvas_dom_host::JsErrorKind::TypeError => JsNativeError::typ()
+            .with_message(error.to_string())
+            .into(),
+    }
+}
+
+/// Run a shared host operation on the document, mapping errors to JS exceptions
+pub(crate) fn host<T>(
+    context: &mut Context,
+    f: impl FnOnce(&mut blitz_dom::BaseDocument) -> canvas_dom_host::DomResult<T>,
+) -> JsResult<T> {
+    let ctx = dom_ctx(context)?;
+    let result = f(&mut ctx.doc.borrow_mut());
+    result.map_err(|e| throw_dom(context, e))
+}

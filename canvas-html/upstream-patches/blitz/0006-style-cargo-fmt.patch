From 17b5c86058847927ca4f76b7e010c78b8941edb5 Mon Sep 17 00:00:00 2001
From: local <l@l>
Date: Mon, 5 Oct 2026 11:06:43 +0000
Subject: [PATCH 6/6] style: cargo fmt

---
 packages/blitz-dom/src/layout/construct.rs    | 30 +++++++++++++++----
 packages/blitz-paint/src/render/background.rs | 20 +++++++++++--
 packages/blitz-paint/src/text.rs              | 19 +++++++++---
 3 files changed, 57 insertions(+), 12 deletions(-)

diff --git a/packages/blitz-dom/src/layout/construct.rs b/packages/blitz-dom/src/layout/construct.rs
index 5b5a2ae..516a4b4 100644
--- a/packages/blitz-dom/src/layout/construct.rs
+++ b/packages/blitz-dom/src/layout/construct.rs
@@ -1096,7 +1096,13 @@ pub(crate) fn build_inline_layout_into(
 
     let at_word_start = &mut true;
     if let Some(before_id) = root_node.before() {
-        build_inline_layout_recursive(&mut builder, nodes, before_id, text_transform, at_word_start);
+        build_inline_layout_recursive(
+            &mut builder,
+            nodes,
+            before_id,
+            text_transform,
+            at_word_start,
+        );
     }
     for child_id in root_node.children.iter().copied() {
         build_inline_layout_recursive(&mut builder, nodes, child_id, text_transform, at_word_start);
@@ -1172,7 +1178,13 @@ pub(crate) fn build_inline_layout_into(
                         );
                         for child_id in node.children.iter().copied() {
                             // node.remove_damage(CONSTRUCT_DESCENDENT | CONSTRUCT_FC | CONSTRUCT_BOX);
-                            build_inline_layout_recursive(builder, nodes, child_id, text_transform, at_word_start);
+                            build_inline_layout_recursive(
+                                builder,
+                                nodes,
+                                child_id,
+                                text_transform,
+                                at_word_start,
+                            );
                         }
                         builder.pop_style_span();
                     }
@@ -1221,7 +1233,8 @@ pub(crate) fn build_inline_layout_into(
                                     builder,
                                     nodes,
                                     before_id,
-                                    text_transform, at_word_start,
+                                    text_transform,
+                                    at_word_start,
                                 );
                             }
 
@@ -1230,7 +1243,8 @@ pub(crate) fn build_inline_layout_into(
                                     builder,
                                     nodes,
                                     child_id,
-                                    text_transform, at_word_start,
+                                    text_transform,
+                                    at_word_start,
                                 );
                             }
                             if let Some(after_id) = node.after() {
@@ -1238,7 +1252,8 @@ pub(crate) fn build_inline_layout_into(
                                     builder,
                                     nodes,
                                     after_id,
-                                    text_transform, at_word_start,
+                                    text_transform,
+                                    at_word_start,
                                 );
                             }
 
@@ -1340,6 +1355,9 @@ mod capitalize_tests {
         assert_eq!(capitalize_words("hello wide", &mut start), "Hello Wide");
         // "wide" + "r world": the second node continues the word "wider"
         assert_eq!(capitalize_words("r world", &mut start), "r World");
-        assert_eq!(capitalize_words(" (quoted) well-known", &mut start), " (Quoted) Well-known");
+        assert_eq!(
+            capitalize_words(" (quoted) well-known", &mut start),
+            " (Quoted) Well-known"
+        );
     }
 }
diff --git a/packages/blitz-paint/src/render/background.rs b/packages/blitz-paint/src/render/background.rs
index 5aa5931..8756829 100644
--- a/packages/blitz-paint/src/render/background.rs

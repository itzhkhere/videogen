diff --git a/packages/blitz-paint/src/text.rs b/packages/blitz-paint/src/text.rs
index addf1db..4dfa7ad 100644
--- a/packages/blitz-paint/src/text.rs
+++ b/packages/blitz-paint/src/text.rs
@@ -585,7 +585,10 @@ pub(crate) fn stroke_text<'a>(
         // `text-overflow`: when this line runs past the end of the clipping box, the glyphs
         // that do not fit together with the ellipsis are dropped and the ellipsis is drawn
         // after the last one that does (left-to-right lines only for now).
-        let mut overflow_cut = ellipsis.as_ref().filter(|e| e.line_overflows(&line)).cloned();
+        let mut overflow_cut = ellipsis
+            .as_ref()
+            .filter(|e| e.line_overflows(&line))
+            .cloned();
         // `text-shadow` is painted below all of the line's text.
         draw_line_text_shadows(scene, &line, doc, transform, scale, overflow_cut.clone());
         // Decorations accumulated for this line, keyed by decorating box, so each box is
@@ -863,7 +866,10 @@ fn draw_line_text_shadows(
         if shadows.is_empty() {
             continue;
         }
-        let glyphs: Vec<anyrender::Glyph> = glyphs.into_iter().chain(marker.unwrap_or_default()).collect();
+        let glyphs: Vec<anyrender::Glyph> = glyphs
+            .into_iter()
+            .chain(marker.unwrap_or_default())
+            .collect();
         let synthesis = run.synthesis();
         let glyph_xform = synthesis
             .skew()
@@ -884,7 +890,10 @@ fn draw_line_text_shadows(
         );
 
         for shadow in shadows.iter().rev() {
-            let color = shadow.color.resolve_to_absolute(&current_color).as_srgb_color();
+            let color = shadow
+                .color
+                .resolve_to_absolute(&current_color)
+                .as_srgb_color();
             let dx = shadow.horizontal.px() as f64 * scale;
             let dy = shadow.vertical.px() as f64 * scale;
             let blur = shadow.blur.px() as f64 * scale;
@@ -900,7 +909,9 @@ fn draw_line_text_shadows(
                     1.0,
                     shadow_transform,
                     &bounds,
-                    Some(Arc::new(Filter::linear_list(std::iter::once(FilterEffect::blur(std_dev as f32))))),
+                    Some(Arc::new(Filter::linear_list(std::iter::once(
+                        FilterEffect::blur(std_dev as f32),
+                    )))),
                     None,
                 );
             }

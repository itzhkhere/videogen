+                None,
+            );
             self.draw_background_layers(scene);
-            scene.push_layer(Fill::NonZero, Compose::DestIn, 1.0, self.transform, &bounds, None, None);
+            scene.push_layer(
+                Fill::NonZero,
+                Compose::DestIn,
+                1.0,
+                self.transform,
+                &bounds,

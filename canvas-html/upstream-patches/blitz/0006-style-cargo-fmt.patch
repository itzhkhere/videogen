@@ -149,9 +149,25 @@ impl ElementCx<'_, '_> {
             && self.element.inline_layout_data.is_some();
         if clip_to_text {
             let bounds = self.frame.border_box_path();
-            scene.push_layer(Fill::NonZero, Mix::Normal, 1.0, self.transform, &bounds, None, None);
+            scene.push_layer(
+                Fill::NonZero,
+                Mix::Normal,
+                1.0,
+                self.transform,
